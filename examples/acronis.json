  "target": {
    "apiUrl": "https://acronis.example.invalid",
    "clientIdEnv": "ACRONIS_CLIENT_ID",
    "clientSecretEnv": "ACRONIS_CLIENT_SECRET",
    "applicationCodeEnv": "ACRONIS_APPLICATION_CODE",
    "alertType": "cti.REPLACE_WITH_REGISTERED_ALERT_TYPE.v1.0",
    "category": "cti.REPLACE_WITH_REGISTERED_CATEGORY.v1.0"
  },
  "mappings": [{"assetId": "REPLACE_WITH_SELECTED_WEBSITE_ID", "tenantId": "00000000-0000-0000-0000-000000000000"}],
  "stateFile": "./private-state/acronis.json",
  "minimumSeverity": "medium",
  "autoResolve": false
}
